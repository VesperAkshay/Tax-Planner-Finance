# ==============================================================================
# Database Configuration (Neon Serverless PostgreSQL)
# ==============================================================================
# Neon connection string format:
# postgresql+asyncpg://<user>:<password>@<neon-hostname>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD_HERE@ep-example.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# Synchronous connection string (used by Alembic migrations):
# postgresql://<user>:<password>@<neon-hostname>/<dbname>?sslmode=require
SYNC_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# Application Settings
# ==============================================================================
ENVIRONMENT=development
APP_NAME=Personal Finance + Tax Regime Planner
DEBUG=True
HOST=127.0.0.1
PORT=8000

# ==============================================================================
# JWT Authentication
# ==============================================================================
SECRET_KEY=replace-this-with-a-secure-random-secret-key-min-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# LLM API Keys (OpenRouter free models supported out-of-the-box)
# ==============================================================================
# If using OpenRouter:
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Or if using standard OpenAI / Anthropic:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# Paths & Storage
# ==============================================================================
CHROMA_PERSIST_DIR=./data/chromadb
TAX_RULES_DIR=./data/tax_rules
TEST_FIXTURES_DIR=./data/test_fixtures
